{
  "theme": "dark",
  "mcpServers": {
    "other": {
      "command": "npx",
      "args": [
        "-y",
        "x"
      ]
    },
    "mem-personal": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/opt/mem",
        "mem",
        "serve",
        "--store",
        "personal=/data/personal.db"
      ]
    },
    "mem-work": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/opt/mem",
        "mem",
        "serve",
        "--store",
        "work=/data/work.db"
      ]
    }
  }
}
