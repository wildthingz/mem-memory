{
  "mcpServers": {
    "mem-personal": {
      "type": "http",
      "url": "http://127.0.0.1:8765/personal/mcp",
      "headers": {
        "Authorization": "Bearer ${MEM_TOKEN}",
        "X-Mem-Host": "${MEM_HOST:-local}"
      }
    },
    "mem-work": {
      "type": "http",
      "url": "http://127.0.0.1:8765/work/mcp",
      "headers": {
        "Authorization": "Bearer ${MEM_TOKEN}",
        "X-Mem-Host": "${MEM_HOST:-local}"
      }
    }
  }
}
